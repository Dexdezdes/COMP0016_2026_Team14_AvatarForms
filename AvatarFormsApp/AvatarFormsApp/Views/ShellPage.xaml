<Page
x:Class="AvatarFormsApp.Views.ShellPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:helpers="using:AvatarFormsApp.Helpers"
xmlns:behaviors="using:AvatarFormsApp.Behaviors"
xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
xmlns:interactions="using:Microsoft.Xaml.Interactions.Core"
xmlns:models="using:AvatarFormsApp.Models"
Loaded="OnLoaded">
    <Page.Resources>
        <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
        <Thickness x:Key="NavigationViewMinimalContentMargin">0</Thickness>
    </Page.Resources>

    <Grid>
        <NavigationView
            x:Name="NavigationViewControl"
            Margin="0"
            Padding="0"
            Canvas.ZIndex="0"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            IsPaneOpen="False"
            IsSettingsVisible="True"
            VerticalAlignment="Stretch" 
            HorizontalAlignment="Stretch"
            AlwaysShowHeader="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnItemInvoked">

            <!-- Pane header (logo + app name) -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="8,8">
                    <TextBlock Text=" AvatarForms" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- Overview section -->
                <NavigationViewItemHeader Content="Overview" />
                <NavigationViewItem Content="Dashboard" x:Name="Nav_Dashboard" IsSelected="True" Tag="DashboardPageViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe80f;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Responses section -->
                <NavigationViewItem x:Name="Nav_Responses" Content="Responses">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe8d7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="0">
                <Frame x:Name="NavigationFrame"
                    HorizontalContentAlignment="Stretch" 
                    VerticalContentAlignment="Stretch" />
            </Grid>
        </NavigationView>

        <!-- Settings Overlay -->
        <Border x:Name="ShellSettingsOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="450"
                MaxHeight="600"
                Padding="0"
                CornerRadius="8"
                Background="#E61A1A1A"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#E61A1A1A"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,16">
                    <Grid>
                        <TextBlock Text="Settings"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Click="OnCloseShellSettingsClicked"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Width="32"
                                Height="32"
                                Padding="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Settings Content -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,16">
                    <StackPanel Spacing="20">

                        <!-- Voice Input Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Voice Input"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Border Background="#E61A1A1A"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Auto-send message"
                                                   FontSize="14"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Automatically send message after voice input completes"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoSendToggle"
                                                  Grid.Column="1"
                                                  MinWidth="0"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  IsOn="True"
                                                  Toggled="OnAutoSendToggled"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Avatar Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Avatar"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Border Background="#E61A1A1A"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Select avatar"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="Choose the avatar character used during interviews"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                            <ComboBox x:Name="AvatarComboBox"
                                                      SelectionChanged="OnAvatarSelectionChanged"
                                                      HorizontalAlignment="Stretch">
                                            </ComboBox>

                                            <!-- Browse button for custom avatars -->
                                            <Button x:Name="BrowseAvatarButton"
                                                    Click="OnBrowseAvatarClicked"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,12,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8B5;" />
                                                    <TextBlock Text="Browse for .glb avatar" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                        </StackPanel>

                        <!-- Voice Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Voice"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Border Background="#E61A1A1A"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Select voice"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="Choose the voice for the avatar"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="VoiceComboBox"
                                              SelectionChanged="OnVoiceSelectionChanged"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Fenrir (American Male)" Tag="am_fenrir" />
                                        <ComboBoxItem Content="Bella (American Female)" Tag="af_bella" />
                                        <ComboBoxItem Content="Fable (British Male)" Tag="bm_fable" />
                                        <ComboBoxItem Content="Isabella (British Female" Tag="bf_isabella" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Speech Language Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Language"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Border Background="#E61A1A1A"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Select recognition language"
                                               FontSize="14"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="Choose the language for speech recognition"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="LanguageComboBox"
                                              SelectionChanged="OnLanguageSelectionChanged"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName">
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
